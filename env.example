# Copy this file to .env and fill it in. Without a key the offline rule-based parser is used.
GEMINI_API_KEY=
# Optional. Defaults to the "gemini-flash-latest" alias. Set a specific model name from Google AI Studio if needed.
GEMINI_MODEL=
# Optional backup model, tried only if the main model stays overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODEL=
